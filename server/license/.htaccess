<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:private|data|\.git)(?:/|$) - [F,L]
    RewriteRule ^connect/?$ connect.php [L]
    RewriteRule ^get-key/?$ get-key.php [L]
    RewriteRule ^lib/protected/([A-Za-z0-9][A-Za-z0-9._-]{0,79}\.so(?:\.manifest)?)$ libdl.php?f=$1 [L,QSA]
    RewriteRule ^lib/token/?$ libtok.php [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(lib|config|giveaway_lib|SessionProtocol|libstore|libdl|libtok)\.php$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(?i)(\.(pem|key|zip|json|bak|old|log|sqlite|db)$|~$|^\.env)">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^(lib|config|giveaway_lib|SessionProtocol|libstore|libdl|libtok)\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "(?i)(\.(pem|key|zip|json|bak|old|log|sqlite|db)$|~$|^\.env)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
